# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM: local Ollama by default (no external API calls). See backend/finetune/README.md.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=documind-qwen2.5-1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b-instruct

# Gemini: only used when LLM_PROVIDER=gemini
# Model used for QA / summarization / comparison narration
GEMINI_MODEL=gemini-3.5-flash-lite

# Local storage
DATABASE_URL=sqlite:///./storage/documind.db
UPLOAD_DIR=./storage/uploads
VECTOR_DIR=./storage/vector_index

# Embedding model (local, downloaded on first run — ~90MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Secret used to sign auth JWTs — set a real random value before deploying
# anywhere shared (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
JWT_SECRET=dev-insecure-secret-change-me
